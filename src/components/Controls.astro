---
import type { TranslationData } from '@/i18n';
interface Props { t: TranslationData; }
const { t } = Astro.props;
---

<section class="py-16 bg-gray-800">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <img src="/img/logo_infobillard_orange.png" alt="InfoBillard" class="mx-auto mb-6 w-32" loading="lazy" />
    <p class="text-2xl sm:text-3xl font-bold text-brand leading-relaxed">
      {t.controlsSlogan.line1}<br />
      {t.controlsSlogan.line2}<br />
      {t.controlsSlogan.line3}
    </p>
  </div>
</section>

<section id="controls" class="py-20 bg-gray-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-center mb-16">
      <span class="text-brand">{t.controls.heading} </span>
      <span class="text-white">{t.controls.headingAccent}</span>
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      {t.controls.items.map((item) => (
        <div class:list={[
          'rounded-xl border overflow-hidden flex flex-col',
          item.recommended
            ? 'border-brand bg-gray-800 ring-2 ring-brand shadow-lg shadow-brand/20 relative'
            : 'border-gray-700 bg-gray-800'
        ]}>
          {item.recommended && (
            <div class="bg-brand text-white text-center py-2 font-bold text-sm uppercase tracking-wider">
              {item.recommendedLabel}
            </div>
          )}
          <div class="p-6 flex-1 flex flex-col">
            <h3 class="text-xl font-bold text-white mb-1">{item.title}</h3>
            <p class="text-gray-400 text-sm mb-6">{item.subtitle}</p>
            <ul class="space-y-3 flex-1">
              {item.features.map((feature: string) => (
                <li class="flex items-start gap-2">
                  <svg class="w-5 h-5 text-brand flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="text-gray-300 text-sm">{feature}</span>
                </li>
              ))}
            </ul>
            <a href={`mailto:info@infobillard.ca?subject=${encodeURIComponent(item.subject)}`}
               class:list={[
                 'mt-6 block text-center py-3 rounded-lg font-bold transition-colors',
                 item.recommended ? 'bg-brand hover:bg-brand-dark text-white' : 'bg-gray-700 hover:bg-gray-600 text-white'
               ]}>
              {t.controls.inquireBtn}
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="bg-gray-800 rounded-xl p-8 text-center border border-gray-700">
      <p class="text-xl font-bold">
        <span class="text-white">{t.controls.orderNow.split('INFOBILLARD')[0]}</span>
        <span class="text-brand">INFOBILLARD</span>
        <span class="text-white">{t.controls.orderNow.split('INFOBILLARD')[1]}</span>
      </p>
    </div>
  </div>
</section>
