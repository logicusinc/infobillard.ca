---
import type { TranslationData } from '@/i18n';
interface Props { t: TranslationData; }
const { t } = Astro.props;

const screens = [
  { src: '/images/infobillard_principal.png', alt: 'InfoBillard - Main' },
  { src: '/images/infobillard_membre.png', alt: 'InfoBillard - Members' },
  { src: '/images/infobillard_produits.png', alt: 'InfoBillard - Products' },
];
---

<section class="py-20 bg-gray-900 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <span class="inline-block px-6 py-2 bg-brand text-white font-bold rounded-full text-lg">
        {t.screenshots.badge}
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {screens.map((screen) => (
        <div class="rounded-xl overflow-hidden border border-gray-700 hover:border-brand/50 transition-all duration-300 hover:-translate-y-1 shadow-lg hover:shadow-brand/20">
          <div class="bg-gray-800 h-8 flex items-center px-3 gap-1.5">
            <span class="w-3 h-3 rounded-full bg-red-500"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500"></span>
            <span class="w-3 h-3 rounded-full bg-green-500"></span>
          </div>
          <img src={screen.src} alt={screen.alt} class="w-full" loading="lazy" />
        </div>
      ))}
    </div>
  </div>
</section>
