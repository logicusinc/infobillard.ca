---
import type { TranslationData } from '@/i18n';
interface Props { t: TranslationData; }
const { t } = Astro.props;
---

<footer id="contact" class="py-20 bg-gray-800 border-t border-gray-700">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-center mb-16">
      <span class="text-brand">{t.contact.heading} </span>
      <span class="text-white">{t.contact.headingAccent}</span>
    </h2>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <div>
        <h3 class="text-lg font-bold text-brand mb-6 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          {t.contact.testimonialsTitle}
        </h3>
        <div class="space-y-4">
          {t.contact.testimonials.map((testimonial) => (
            <blockquote class="bg-gray-900 rounded-lg p-4 border border-gray-700">
              <p class="text-gray-300 italic text-sm mb-2">"{testimonial.text}"</p>
              <cite class="text-brand text-xs font-semibold not-italic">{testimonial.author}</cite>
            </blockquote>
          ))}
        </div>
      </div>

      <div class="text-center">
        <img src="/img/logo_infobillard_orange.png" alt="InfoBillard" class="mx-auto mb-6 w-40" loading="lazy" />
        <div class="space-y-2 text-gray-300">
          <p class="font-bold text-white">{t.contact.regionLabel}</p>
          <p>{t.contact.companyLabel}: <a href="https://www.logicus.qc.ca/" target="_blank" rel="noopener" class="text-brand hover:underline">Logicus Informatique inc.</a></p>
          <p>{t.contact.tollFree}: <a href="tel:18888247474" class="hover:text-brand">(888) 824-7474</a></p>
          <p>{t.contact.phone}: <a href="tel:14502247474" class="hover:text-brand">(450) 224-7474</a></p>
          <p><a href="mailto:info@infobillard.ca" class="text-brand hover:underline">info@infobillard.ca</a></p>
        </div>
      </div>

      <div>
        <h3 class="text-lg font-bold text-brand mb-6 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          {t.contact.partnersTitle}
        </h3>
        <div class="space-y-4">
          {t.contact.partners.map((partner) => (
            <div class="bg-gray-900 rounded-lg p-3 border border-gray-700">
              <p class="text-xs font-bold text-gray-400 uppercase mb-1">{partner.region}</p>
              <p class="text-sm"><a href={partner.url} target="_blank" rel="noopener" class="text-brand hover:underline">{partner.company}</a></p>
              {'phones' in partner && partner.phones ? (
                partner.phones.map((ph: string) => <p class="text-gray-400 text-sm">{ph}</p>)
              ) : (
                <p class="text-gray-400 text-sm">{partner.phone}</p>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-gray-700 text-center">
      <p class="text-gray-500 text-sm">
        <a href="https://www.logicus.qc.ca" target="_blank" rel="noopener" class="hover:text-brand">{t.footer.copyright}</a>
      </p>
    </div>
  </div>
</footer>
